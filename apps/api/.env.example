# Database configuration
DATABASE_URL="postgres://postgres:postgres@localhost:5432/fitforge"

# JWT configuration
JWT_SECRET="your-super-secret-jwt-key"
JWT_REFRESH_SECRET="your-super-secret-refresh-key"

# Application
PORT=3000
NODE_ENV="development"

# ─── Auth rate limiting ──────────────────────────────────────
# Per-IP ceilings on the unauthenticated auth endpoints, per window. Leave blank
# for the defaults in src/modules/auth/auth.throttle.ts (300 / 30 / 300 per
# minute), which is also where the reasoning lives.
#
# These are flood brakes, not the anti-brute-force measure — that is the
# per-account failure counter, which no setting here can weaken. Raise them if a
# legitimate shared egress (an office NAT, a carrier-grade NAT, or a load
# balancer with TRUST_PROXY left at false) is 429ing real users, since every
# person behind one address shares a single bucket.
AUTH_LOGIN_RATE_LIMIT=""
AUTH_REGISTER_RATE_LIMIT=""
AUTH_REFRESH_RATE_LIMIT=""
AUTH_RATE_LIMIT_TTL_MS=""

# ─── Password reset ──────────────────────────────────
# Where a reset link points: <APP_PUBLIC_URL>/reset-password?token=...
# Blank falls back to the app scheme, fitforge://, which is right for a native
# client in development. Set it to your public web origin once one exists.
#
# NOTE: no email transport is configured. Outside production the link is written
# to the server log; in production the attempt is logged at error level and the
# request still answers 202. See PasswordResetDelivery before relying on this.
APP_PUBLIC_URL=""

# ─── Billing ──────────────────────────────────────────
# POST /subscriptions/upgrade is a mock purchase: it moves a user onto any plan
# id from GET /subscriptions/plans with no payment at all. Left unset it is ON
# outside production and OFF in production, so deploying before billing exists
# cannot give the paid tiers away. Set to "true" only for a demo environment.
ALLOW_UNPAID_UPGRADES=""

# ─── HTTP hardening ──────────────────────────────────────────
# Browser origins allowed to call this API, comma separated. Native clients send
# no Origin header and are unaffected. Left unset this defaults to the Expo dev
# server only (http://localhost:8081, http://localhost:19006) — a deployed web
# front-end is CORS-blocked until its origin is listed here.
CORS_ORIGINS="http://localhost:8081,http://localhost:19006"

# Whether X-Forwarded-For is believed, and so what counts as "the client" for
# @Ip() and the login throttler. `false` when this process faces the internet
# directly. Behind a load balancer or reverse proxy set it to the hop count
# (e.g. 1) — left false there, every request appears to come from the proxy, so
# the entire user base shares one rate-limit bucket and a single attacker can
# 429 everyone. Setting it too high lets a caller spoof its own address.
TRUST_PROXY="false"

# ─── Refresh-token cookie (browser clients only) ─────────────
# Web clients receive the refresh token as an HttpOnly cookie so page scripts
# cannot read it. Native clients send and receive it in the JSON body and are
# unaffected by anything here.
#
# SameSite is a *site* rule: localhost:8081 -> localhost:3000, and
# app.example.com -> api.example.com, are same-site, so "lax" is right for
# development and subdomain deployments. Use "none" only for a genuinely
# cross-site split (different registrable domains); browsers then require
# Secure, which is switched on automatically.
AUTH_REFRESH_COOKIE_SAMESITE="lax"
# "true"/"false". Blank = on in production, off elsewhere (a Secure cookie is
# silently dropped over plain http, and local development is plain http).
AUTH_REFRESH_COOKIE_SECURE=""

# OpenAI (for AI Meal Logger)
OPENAI_API_KEY="sk-..."

# USDA FoodData Central — primary database for food search.
# Free key: https://fdc.nal.usda.gov/api-key-signup.html
# Optional: without it, search falls back to Open Food Facts alone (no key needed).
USDA_FDC_API_KEY=""

# ─── Media storage ───────────────────────────────────────────
# Which backend holds exercise videos and images. Only "r2" is implemented;
# adding "s3" or "gcs" means writing one StorageProvider class.
STORAGE_PROVIDER="r2"

# Cloudflare R2. Create an R2 API token scoped to a single bucket with
# Object Read & Write — never an account-wide token.
# The API is usable without these; uploads and signed URLs are simply disabled.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="fitforge-media"
# Optional: overrides https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=""

# Public base URL for the bucket — an R2 custom domain (recommended: it gets you
# Cloudflare caching and WAF) or the bucket's r2.dev address. Leave EMPTY to keep
# the bucket private, in which case every playback URL is signed and expiring.
R2_PUBLIC_BASE_URL=""

# "public"  — instructional videos served straight from the CDN edge. Fastest and
#             cacheable; requires R2_PUBLIC_BASE_URL.
# "private" — nothing is world-readable; each playback mints a signed URL.
MEDIA_DEFAULT_VISIBILITY="public"

# Signed URL lifetimes, in seconds. SigV4 caps downloads at 7 days.
MEDIA_SIGNED_URL_TTL_SECONDS=3600
MEDIA_UPLOAD_URL_TTL_SECONDS=900

# Upload limits, in bytes. A 10–30s 720p H.264 clip is typically 2–8 MB.
MEDIA_MAX_VIDEO_BYTES=104857600
MEDIA_MAX_IMAGE_BYTES=5242880

# Key namespace inside the bucket.
MEDIA_KEY_PREFIX="exercises"

# ffmpeg/ffprobe, used to measure uploads and cut poster frames. Resolved
# automatically from the bundled ffmpeg-static / ffprobe-static packages, then
# PATH. Set these only to point at your own build.
FFMPEG_PATH=""
FFPROBE_PATH=""
