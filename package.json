{
  "name": "fitforge",
  "version": "1.0.0",
  "private": true,
  "description": "FitForge — Premium Fitness App (Monorepo)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "api:dev": "cd apps/api && npm run start:dev",
    "api:build": "cd apps/api && npm run build",
    "api:test": "cd apps/api && npm run test",
    "mobile:start": "cd apps/mobile && npx expo start",
    "mobile:ios": "cd apps/mobile && npx expo start --ios",
    "mobile:android": "cd apps/mobile && npx expo start --android"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
